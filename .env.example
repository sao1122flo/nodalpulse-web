# Database (Railway Postgres)
DATABASE_URL=postgresql://user:password@host:5432/nodalpulse

# Auth (better-auth)
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string-here
BETTER_AUTH_URL=http://localhost:3000

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAM=price_...
STRIPE_PRICE_ORG=price_...

# OAuth (Microsoft Entra ID + Google)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Brevo (transactional email)
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@nodalpulse.com
BREVO_FROM_NAME=NodalPulse

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=nodalpulse-docs

# Admin (comma-separated email addresses granted /__admin access)
ADMIN_EMAILS=you@example.com

# Sentry
SENTRY_DSN=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Services API
SERVICES_API_URL=https://api.nodalpulse.com
SERVICES_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
